# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

test error-zero-parameter {
    SELECT $0;
}
@sqlstate 42P02
expect error {}

# tursopg does not have LISTEN.
@compat-gap "syntax:unsupported-statement"
test error-unsupported-statement {
    LISTEN channel;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {
}

test error-values-lists-have-different-lengths {
    VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-lists-have-different-lengths {
    CREATE TABLE t (a int, b int);
    INSERT INTO t VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-default-and-short-row {
    CREATE TABLE t (a int, b int);
    INSERT INTO t (a, b) VALUES (1, DEFAULT), (2);
}
@sqlstate 42601
expect error {}

test error-insert-values-defaults-fewer-than-columns {
    CREATE TABLE t (a int, b int, c int);
    INSERT INTO t (a, b, c) VALUES (DEFAULT, DEFAULT);
}
@sqlstate 42601
expect error {}

test error-insert-values-one-default-fewer-than-columns {
    CREATE TABLE t (a int, b int, c int);
    INSERT INTO t (a, b, c) VALUES (DEFAULT);
}
@sqlstate 42601
expect error {}

test error-insert-values-value-and-default-fewer-than-columns {
    CREATE TABLE t (a int, b int, c int);
    INSERT INTO t (a, b, c) VALUES (1, DEFAULT);
}
@sqlstate 42601
expect error {}

test error-insert-several-default-rows-fewer-than-columns {
    CREATE TABLE t (a int, b int, c int);
    INSERT INTO t (a, b, c) VALUES (DEFAULT, DEFAULT), (DEFAULT, DEFAULT);
}
@sqlstate 42601
expect error {}

test error-insert-values-defaults-more-than-columns {
    CREATE TABLE t (a int, b int, c int);
    INSERT INTO t (a, b) VALUES (DEFAULT, DEFAULT, 3);
}
@sqlstate 42601
expect error {}

test error-insert-values-only-defaults-more-than-columns {
    CREATE TABLE t (a int, b int, c int);
    INSERT INTO t (a, b) VALUES (DEFAULT, DEFAULT, DEFAULT);
}
@sqlstate 42601
expect error {}

# PostgreSQL looks up the table and the values before it
# compares the row length with the column list.
test error-insert-default-row-wrong-length-missing-table {
    INSERT INTO missing (a, b) VALUES (DEFAULT);
}
@sqlstate 42P01
expect error {}

test error-insert-default-row-wrong-length-missing-value-column {
    CREATE TABLE t (a int, b int, c int);
    INSERT INTO t (a, b) VALUES (DEFAULT, DEFAULT, nonexistent);
}
@sqlstate 42703
expect error {}

test error-insert-into-missing-column {
    CREATE TABLE t (a int, b int DEFAULT 7);
    INSERT INTO t (a, zz) VALUES (1, 2);
}
@sqlstate 42703
expect error {}

test error-insert-default-into-missing-column {
    CREATE TABLE t (a int, b int DEFAULT 7);
    INSERT INTO t (zz) VALUES (DEFAULT);
}
@sqlstate 42703
expect error {}

test error-insert-value-and-default-into-missing-column {
    CREATE TABLE t (a int, b int DEFAULT 7);
    INSERT INTO t (a, zz) VALUES (1, DEFAULT);
}
@sqlstate 42703
expect error {}

test error-insert-defaults-into-missing-column {
    CREATE TABLE t (a int, b int DEFAULT 7);
    INSERT INTO t (a, zz) VALUES (DEFAULT, DEFAULT), (DEFAULT, DEFAULT);
}
@sqlstate 42703
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

# Schema databases are file-backed, so the schema table is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}

test error-drop-type-used-by-a-cast-in-a-policy {
    CREATE TYPE err_policy_mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_policy_t (m text);
    CREATE POLICY err_policy_p ON err_policy_t USING (m::err_policy_mood = 'happy');
    DROP TYPE err_policy_mood;
}
@sqlstate 2BP01
expect error {}
